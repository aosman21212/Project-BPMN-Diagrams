<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List ─────────────────────────────────────────────────────────── -->
    <record id="view_project_bpmn_diagram_list" model="ir.ui.view">
        <field name="name">project.bpmn.diagram.list</field>
        <field name="model">project.bpmn.diagram</field>
        <field name="arch" type="xml">
            <list string="BPMN Diagrams">
                <field name="name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="element_count" string="Elements"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- ── Form ─────────────────────────────────────────────────────────── -->
    <record id="view_project_bpmn_diagram_form" model="ir.ui.view">
        <field name="name">project.bpmn.diagram.form</field>
        <field name="model">project.bpmn.diagram</field>
        <field name="arch" type="xml">
            <form string="BPMN Diagram">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Diagram name…"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Linked to">
                            <field name="project_id"/>
                            <field name="task_id"
                                   domain="[('project_id','=',project_id)]"/>
                        </group>
                        <group string="Info">
                            <field name="element_count" string="Elements"/>
                            <field name="description" placeholder="Optional notes…"/>
                        </group>
                    </group>

                    <!-- ── BPMN Canvas Widget ─────────────────────────── -->
                    <field name="diagram_data"
                           widget="bpmn_editor"
                           nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Action ───────────────────────────────────────────────────────── -->
    <record id="action_project_bpmn_diagram" model="ir.actions.act_window">
        <field name="name">BPMN Diagrams</field>
        <field name="res_model">project.bpmn.diagram</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
